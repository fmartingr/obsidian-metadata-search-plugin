{
	"name": "obsidian-book-search-plugin",
	"description": "This is a plugin to help you create book notes.",
	"homepage": "https://fmartingr.github.io/obsidian-book-search-plugin/",
	"keywords": [
		"book",
		"book note",
		"obsidian",
		"plugin"
	],
	"author": "fmartingr",
	"license": "MIT",
	"engines": {
		"node": ">= 20"
	},
	"scripts": {
		"dev": "bun run esbuild.config.mjs",
		"test": "jest",
		"format": "prettier --write \"**/*.ts\"",
		"format:check": "prettier --check \"**/*.ts\"",
		"lint": "bun run format:check && eslint . --ext .ts && tsc --noEmit -skipLibCheck",
		"lint:fix": "bun run format && eslint . --ext .ts --fix",
		"build": "bun run lint && bun run esbuild.config.mjs production",
		"prepare": "husky",
		"deploy:pages": "gh-pages -d pages",
		"vault:install": "bun run scripts/install-to-vault.ts",
		"vault:uninstall": "bun run scripts/uninstall-from-vault.ts"
	},
	"devDependencies": {
		"@popperjs/core": "^2.11.8",
		"@types/jest": "^29.5.12",
		"@types/node": "^20.12.7",
		"@typescript-eslint/eslint-plugin": "^7.8.0",
		"@typescript-eslint/parser": "^7.8.0",
		"builtin-modules": "^4.0.0",
		"esbuild": "0.20.2",
		"eslint": "^8.57.0",
		"gh-pages": "^4.0.0",
		"husky": "^9.0.11",
		"jest": "^29.7.0",
		"jest-environment-jsdom": "^29.7.0",
		"obsidian": "latest",
		"prettier": "^3.2.5",
		"standard-version": "^9.5.0",
		"ts-jest": "^29.1.2",
		"tslib": "2.6.2",
		"typescript": "5.1.6"
	}
}
