{
	"name": "obsidian-metadata-search-plugin",
	"description": "This is a plugin to help you create book notes.",
	"homepage": "https://fmartingr.github.io/obsidian-metadata-search-plugin/",
	"keywords": [
		"book",
		"book note",
		"obsidian",
		"plugin"
	],
	"author": "fmartingr",
	"license": "MIT",
	"engines": {
		"node": ">= 20"
	},
	"scripts": {
		"dev": "bun run esbuild.config.mjs",
		"test": "jest",
		"format": "prettier --write \"**/*.ts\"",
		"format:check": "prettier --check \"**/*.ts\"",
		"lint": "bun run format:check && bun --bun eslint . && tsc --noEmit -skipLibCheck",
		"lint:fix": "bun run format && bun --bun eslint . --fix",
		"build": "bun run lint && bun run esbuild.config.mjs production",
		"prepare": "husky",
		"deploy:pages": "gh-pages -d pages",
		"vault:install": "bun run build && bun run scripts/install-to-vault.ts",
		"vault:uninstall": "bun run scripts/uninstall-from-vault.ts",
		"vault:symlink": "bun run scripts/symlink-to-vault.ts",
		"vault:unlink": "bun run scripts/unlink-from-vault.ts"
	},
	"devDependencies": {
		"@popperjs/core": "^2.11.8",
		"@types/jest": "^30",
		"@types/node": "^25.2.3",
		"builtin-modules": "^5.0.0",
		"esbuild": "0.27.4",
		"eslint": "^10",
		"gh-pages": "^6.3.0",
		"husky": "^9.1.7",
		"jest": "^30",
		"jest-environment-jsdom": "^30",
		"obsidian": "^1.12.0",
		"prettier": "^3.8.1",
		"standard-version": "^9.5.0",
		"ts-jest": "^29.4.6",
		"tslib": "2.8.1",
		"typescript": "5.9.3",
		"typescript-eslint": "^8.55.0"
	}
}
